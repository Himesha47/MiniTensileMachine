# ============================================
# MiniTensileMachine — .gitignore
# ============================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.egg-info/
*.egg
dist/
build/
*.whl
.venv/
venv/
env/

# ----- Test data & exported results -----
# CSV data files and PNG/JPG plots exported by the GUI
# (keep them locally in data/ but don't track in git)
data/
*.csv
*.png
*.jpg

# If you want to track specific important images (e.g. screenshots for README),
# use: git add -f <filename>

# ----- KiCad (PCB design) -----
# Auto-generated backup & history files
*.kicad_sch.lck
*.kicad_pcb.lck
*.kicad_pro.lck
~*
**/.history/
*-backups/
fp-info-cache
*.bak
*.tmp
*.zip

# KiCad generated output
PCB/**/Gerber/
PCB/**/*-backups/

# ----- Arduino IDE -----
*.elf
*.hex
*.bin
*.map

# ----- OS junk -----
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ----- Editor / IDE -----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ----- Gemini / AI tools -----
.gemini/
