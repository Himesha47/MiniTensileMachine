# ============================================
# MiniTensileMachine — .gitignore
# ============================================

# ----- Exported test results -----
# CSV data files and PNG plots exported by the GUI go into results/.
# The folder itself is tracked via results/.gitkeep — its contents are not.
results/
!results/.gitkeep

# Belt-and-suspenders: ignore any stray CSV/PNG that land outside results/
*.csv
*.png

# ----- Logs -----
logs/
*.log

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.egg-info/
*.egg
dist/
build/
*.whl
.venv/
venv/
env/

*.jpg

# ----- KiCad (PCB design) -----
# Auto-generated backup & history files
*.kicad_sch.lck
*.kicad_pcb.lck
*.kicad_pro.lck
~*
**/.history/
*-backups/
fp-info-cache
*.bak
*.tmp
*.zip

# KiCad generated output
hardware/pcb/**/Gerber/
hardware/pcb/**/*-backups/

# ----- Arduino IDE -----
*.elf
*.hex
*.bin
*.map

# ----- OS junk -----
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ----- Editor / IDE -----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ----- Gemini / AI tools -----
.gemini/
